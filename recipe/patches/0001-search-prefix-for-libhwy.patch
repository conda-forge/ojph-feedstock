From cffe61efbbaf8492c2312267a24df41f22cabe6e Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sun, 9 Aug 2026 12:24:25 -0400
Subject: [PATCH] Search PREFIX for libhwy so conda-build links the extension
 correctly

<details><summary>Claude's draft</summary>

setup.py's libhwy search only consulted CONDA_PREFIX, which covers an
activated developer environment but not conda-build: there the host
prefix is exposed as PREFIX and CONDA_PREFIX is not set for build
scripts, so the extension silently underlinked and failed at import
with "undefined symbol: hwy::GetChosenTarget()" on conda-forge CI.
Search both variables. The conda-forge 0.10.2 recipe carries this as
a patch until the next release ships it.

Resume this Claude session:
```
cd /home/mark/git/jp2k
claude --resume 487c1e20-36f3-416f-8be1-437c25ed67fe
```
</details>
---
 setup.py | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/setup.py b/setup.py
index 50d6281..e6d6cb0 100644
--- a/setup.py
+++ b/setup.py
@@ -98,12 +98,16 @@ if _static is not None:
         extra_objects.append(_hwy_archives[0])
     else:
         # Only link -lhwy when a libhwy is actually present (a build made
-        # with OJPH_ALLOW_NO_HWY has no hwy references at all).
+        # with OJPH_ALLOW_NO_HWY has no hwy references at all). CONDA_PREFIX
+        # covers an activated developer environment; PREFIX is the host
+        # prefix under conda-build, which does not set CONDA_PREFIX for
+        # build scripts.
         _hwy_dirs = []
-        conda_prefix = os.environ.get('CONDA_PREFIX')
-        if conda_prefix:
-            _hwy_dirs += [os.path.join(conda_prefix, 'lib'),
-                          os.path.join(conda_prefix, 'Library', 'lib')]
+        for _env_var in ('CONDA_PREFIX', 'PREFIX'):
+            _env_prefix = os.environ.get(_env_var)
+            if _env_prefix:
+                _hwy_dirs += [os.path.join(_env_prefix, 'lib'),
+                              os.path.join(_env_prefix, 'Library', 'lib')]
         _hwy_dirs += ['/usr/local/lib', '/usr/lib', '/usr/lib/x86_64-linux-gnu']
         for _d in _hwy_dirs:
             if glob.glob(os.path.join(_d, 'libhwy.*')) or \
